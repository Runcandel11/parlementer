# Salin ke .env untuk development lokal. JANGAN commit file .env asli.
PORT=3000

# Database production (Render + Neon/Supabase). Isi dengan connection string Postgres.
# Contoh Neon:  postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/parlementer?sslmode=require
# Contoh Supabase: postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# Database lokal (dipakai bila DATABASE_URL kosong). File SQLite.
DATABASE_PATH=./data/parlementer.db

# Rahasia penanda sesi login. WAJIB diganti di production (string acak panjang).
JWT_SECRET=parlementer-dev-secret-ganti-di-production
